.landing-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 48rpx;
  background: linear-gradient(180deg, #007AFF 0%, #005EC4 100%);
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.features-section {
  width: 100%;
  margin-top: 80rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  backdrop-filter: blur(10px);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.feature-item + .feature-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.feature-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.invite-section {
  margin-top: 60rpx;
}

.invite-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
}

.action-section {
  width: 100%;
  margin-top: 48rpx;
  padding-bottom: 80rpx;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #FFFFFF;
  color: #007AFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 4rpx;
}

.start-btn::after {
  border: none;
}
