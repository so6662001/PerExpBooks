<view class="landing-container">
  <view class="hero-section">
    <view class="logo-icon">💰</view>
    <view class="title">钱酷报销</view>
    <view class="subtitle">发票拖进去，报销单出来</view>
  </view>

  <view class="features-section">
    <view class="feature-item" wx:for="{{features}}" wx:key="title">
      <view class="feature-icon">{{item.icon}}</view>
      <view class="feature-info">
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="invite-section" wx:if="{{inviteCode}}">
    <view class="invite-text">你的好友邀请你使用</view>
  </view>

  <view class="action-section">
    <button class="start-btn" bindtap="handleStart">立即体验</button>
  </view>
</view>
